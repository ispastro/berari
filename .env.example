# Telegram Bot Configuration
# 1. Talk to @BotFather on Telegram to get your BOT TOKEN: https://t.me/BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# 2. Talk to @userinfobot or start your bot and run /start to get your CHAT ID
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Check Interval in minutes (default is 15 minutes)
CHECK_INTERVAL_MINUTES=15

# Log Level: INFO, DEBUG, WARNING, ERROR
LOG_LEVEL=INFO
